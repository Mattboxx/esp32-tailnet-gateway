cff-version: 1.2.0
message: "Optional citation for the Mattboxx Edition; upstream works are listed separately. Citation is not an additional license condition."
type: software
title: "ESP32 Tailnet Gateway — Mattboxx Edition"
abstract: >-
  Community firmware for the ESP32-S3 that joins a Tailscale or Headscale
  tailnet and provides selective LAN-to-Tailnet service access, subnet
  routing, an access-point gateway, exit-node roles, Wake-on-LAN recovery and
  optional MQTT, Home Assistant, ntfy and SNMP integration.
authors:
  - alias: Mattboxx
version: 3.0.3
date-released: 2026-10-28
license: MIT
repository-code: "https://github.com/Mattboxx/esp32-tailnet-gateway"
url: "https://mattboxx.github.io/esp32-tailnet-gateway/"
keywords:
  - esp32
  - esp32-s3
  - esp-idf
  - tailscale
  - headscale
  - wireguard
  - subnet-router
  - vpn-gateway
  - homelab
  - wake-on-lan
  - home-assistant
  - mqtt
references:
