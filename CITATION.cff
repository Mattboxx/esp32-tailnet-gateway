cff-version: 1.2.0
message: "If you use or reference this firmware, please cite it as below and credit the upstream projects."
type: software
title: "ESP32 Tailnet Gateway — Mattboxx Edition"
abstract: >-
  Community firmware for the ESP32-S3 that joins a Tailscale or Headscale
  tailnet and provides selective LAN-to-Tailnet service access, subnet
  routing, an access-point gateway, exit-node roles, Wake-on-LAN recovery and
  optional MQTT, Home Assistant, ntfy and SNMP integration.
authors:
  - alias: Mattboxx
version: 2.0.2
date-released: 2026-10-23
license: MIT
repository-code: "https://github.com/Mattboxx/esp32-tailnet-gateway"
url: "https://mattboxx.github.io/esp32-tailnet-gateway/"
keywords:
  - esp32
  - esp32-s3
  - esp-idf
  - tailscale
  - headscale
  - wireguard
  - subnet-router
  - vpn-gateway
  - homelab
  - wake-on-lan
  - home-assistant
  - mqtt
references:
  - type: software
    title: esp32-tailscale-subnet-router
    authors:
      - alias: Csontikka
    repository-code: "https://github.com/Csontikka/esp32-tailscale-subnet-router"
    notes: "Upstream base (v0.1.38): Tailscale stack integration, AP router, subnet routing, firewall and Web UI foundation."
  - type: software
    title: MicroLink
    authors:
      - alias: Csontikka
      - alias: CamM2325
    repository-code: "https://github.com/Csontikka/microlink"
    notes: "Embedded Tailscale/WireGuard client, originally based on CamM2325's work."
